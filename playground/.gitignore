# Per-worker runtime: DSH home, browser profile, workspaces, evidence.
.workers/
.workers-*/

# Local config with provider keys and allowed routes; copy config.example.json and fill the real values.
config.json
# Local host provider patch referenced by config.json; endpoint and model ids stay machine-specific.
host.patch.yml
node_modules
*.log
.DS_Store

# Regenerated raw baseline. The generator never writes the upstream checkout.
raw/pstack/

# Review snapshots under reviews/ are committed source; only in-flight staging is transient.
reviews/.staging/

# Session logs contain host paths and may contain credentials; keep local only.
reviews/**/session.jsonl.zstd

# Agent redaction candidate; only validated record.json is committed.
reviews/**/record.safe.json
